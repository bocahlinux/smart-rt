# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — lihat docs/04-SDD.md §6.3
DATABASE_URL=postgres://smartrt:smartrt@localhost:5432/smartrt

# JWT — terpisah dari Django SECRET_KEY (lihat docs/12-CICD.md §7)
JWT_SIGNING_KEY=change-me-to-a-different-random-key
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS — daftar origin frontend yang diizinkan
CORS_ALLOWED_ORIGINS=http://localhost:5173
